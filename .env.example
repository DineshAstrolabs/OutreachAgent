# Source credentials. Leave blank to use fixture-backed stubs.

# 2Captcha (for MC CR lookup image captcha)
TWOCAPTCHA_API_KEY=

# Apollo.io (KSA presence, headcount, vacancies, champions)
APOLLO_API_KEY=

# Crunchbase API (funding rounds)
CRUNCHBASE_API_KEY=

# Anthropic Claude API (news/signals research with web_search)
ANTHROPIC_API_KEY=

# HubSpot
HUBSPOT_API_TOKEN=
HUBSPOT_PORTAL_ID=

# Runtime
OUTREACH_AGENT_MODE=stub   # stub | live
OUTREACH_AGENT_LOG_LEVEL=INFO

# Integration toggles (default true). Set to false to bypass.
# When APOLLO_ENABLED=false: AnthropicCompanySource + AnthropicChampionSource
#   take over (Claude + web_search on publicly available LinkedIn data).
#   Requires ANTHROPIC_API_KEY in live mode.
# When CRUNCHBASE_ENABLED=false: Crunchbase skipped; Anthropic news source
#   already reports funding_last_12mo + funding_mentions_ksa.
# When HUBSPOT_ENABLED=false: result is scored but not written to CRM.
APOLLO_ENABLED=true
CRUNCHBASE_ENABLED=true
HUBSPOT_ENABLED=true
